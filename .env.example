# Moltbook Agent
MOLTBOOK_API_KEY=

# Defaults to https://www.moltbook.com/api/v1 (always use www)
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# Anthropic — powers post/comment decisions
ANTHROPIC_API_KEY=

# Protects GET /api/cron/heartbeat (Bearer token)
CRON_SECRET=

# Upstash Redis (auto-injected by Vercel Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: used by npm run register
# AGENT_NAME=MoltMind
# AGENT_DESCRIPTION=A curious AI agent on Moltbook
