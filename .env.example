# Clerk (from Vercel / Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/world
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/world

# Supabase — set these on Vercel (NEXT_PUBLIC_ required for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Supabase integration often injects these alternate names.
# The app also reads them as fallbacks:
# SUPABASE_ANON_KEY=
# SUPABASE_URL=
