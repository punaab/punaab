# Moltbook — powers post/comment decisions AND live owner chat context
MOLTBOOK_API_KEY=
# Optional: post ID for public owner↔Punaab thread (agent comments when "Reply on Moltbook" is checked)
# MOLTBOOK_OWNER_CHAT_POST_ID=

# Defaults to https://www.moltbook.com/api/v1 (always use www)
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# Anthropic — primary LLM for heartbeat brain (optional if using Aii/OpenRouter)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Aii multi-provider LLM — https://aiiware.com/cloud (100 free requests/day)
# Sign in at cloud.aiiware.com, copy API key. OpenAI-compatible fallback when Anthropic is down.
# AII_CLOUD_API_KEY=
# AII_API_URL=https://cloud.aiiware.com/v1
# AII_MODEL=gemini-2.5-flash

# Optional direct OpenRouter fallback (https://openrouter.ai)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# LLM routing: auto (default) | anthropic | aii | openrouter
# LLM_PROVIDER=auto

# Protects GET /api/cron/heartbeat (Bearer token)
CRON_SECRET=

# Sign in with Moltbook — developer app key from https://moltbook.com/developers/dashboard
# Required for POST /api/agent/collab and other agent APIs
MOLTBOOK_APP_KEY=

# Canonical public URL
# Agent host (APIs, cron, OAuth callbacks) — NOT for tweets
# NEXT_PUBLIC_SITE_URL=https://punaab.vercel.app
# Public marketing URL for X / humans — tweets always use this
# NEXT_PUBLIC_PUBLIC_SHARE_URL=https://www.punaab.com

# Optional: restrict identity tokens to a fixed audience hostname
# MOLTBOOK_AUTH_AUDIENCE=punaab.vercel.app

# Upstash Redis — use ONE of these naming schemes:

# Vercel Upstash / KV integration (auto-injected):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=   # read-only; do not use for the agent
# KV_URL=                        # TCP URL; not used by this app
# REDIS_URL=                     # TCP URL; not used by this app

# Standalone Upstash integration:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: used by npm run register
# AGENT_NAME=MoltMind
# AGENT_DESCRIPTION=A curious AI agent on Moltbook

# Owner dashboard at /admin (password-protected — not public)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ElevenLabs — voice for dashboard owner chat (optional)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Public site URL for app links (optional; VERCEL_URL used if unset)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: USDC price for Punaab cat NFTs sold to agents (default 1)
# PUNAAB_CAT_NFT_PRICE_USDC=1

# Suno AI — agent anthem music NFT generation (https://docs.sunoapi.org/)
SUNO_API_KEY=
# Optional: secret path segment for webhook URL (/api/webhooks/suno/{secret})
# SUNO_CALLBACK_SECRET=

# Music NFT drop (Base ERC-721)
# Deploy: npx tsx scripts/deploy-music-nft.ts
# MUSIC_NFT_CONTRACT_ADDRESS=0x...
# MUSIC_NFT_PRICE_USDC=5
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob for permanent audio hosting
# MUSIC_DROP_LIVE=true     # or flip live from /admin Music NFT panel (Redis-backed)

# Web3 read-only monitoring via Alchemy (https://www.alchemy.com/docs)
# If you see "BASE_MAINNET is not enabled", open your app → Networks → enable Base + Ethereum.
# If you see "App is inactive", create a new app at https://dashboard.alchemy.com/apps
ALCHEMY_API_KEY=
# CU budget: never use Custom Webhooks with empty address/topic filters (~30M CU/day on Base).
# getAssetsByOwner ≈ 480 CU/call — cached 1h by default. Set ALCHEMY_DAS_ENABLED=false to skip DAS.
# ALCHEMY_HOLDINGS_CACHE_SEC=3600
# ALCHEMY_NFT_COUNT_CACHE_SEC=86400
# ALCHEMY_DAS_ENABLED=false
# Alchemy Solana RPC — see https://www.alchemy.com/docs/reference/solana-api-quickstart
# ALCHEMY_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# Your wallets (one per chain) — admin prefers Alchemy Agent Wallet below
WATCH_BASE_ADDRESS=
WATCH_SOLANA_ADDRESS=

# Alchemy Agent Wallet (CLI session) — /admin portfolio + Data APIs primary
# ALCHEMY_WALLET_EVM=0x310648bd5ad77b4a4dd8725d53902d52e475ec73
# ALCHEMY_WALLET_SOLANA=6VoBMcEgfdWSCBYBJ46QkzyHiZ2S4WU6YWRdej5zUbhZ

# Trading (Solana via Jupiter + Base via 0x / Alchemy Wallet APIs)
TRADING_ENABLED=true
TRADING_SOLANA_ADDRESS=
TRADING_BASE_ADDRESS=
# Base58 private key for server-side swap signing (hot wallet or exported key)
# Agent Wallet sessions work via CLI locally; Vercel needs private keys for auto-swaps
# ALCHEMY_CLI_TRADING=true   # default: on locally, off on Vercel
# SOLANA_AGENT_PRIVATE_KEY=
# 0x private key for Base swaps/transfers via @alchemy/wallet-apis + viem
# EVM_AGENT_PRIVATE_KEY=
# Optional: Alchemy gas sponsorship policy (dashboard.alchemy.com)
# ALCHEMY_GAS_POLICY_ID=
# Optional: 0x API key for better Base swap quotes
# ZEROX_API_KEY=
# Alchemy Notify — per-webhook SIGNING KEY for X-Alchemy-Signature HMAC verification
# (Dashboard → your webhook → Signing Key). NOT the global Auth Token.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Legacy alias if you already set this to the signing key:
# ALCHEMY_WEBHOOK_AUTH_TOKEN=
# TRADING_MAX_SOL_PER_TRADE=0.1
# TRADING_MIN_SOL_RESERVE=0.05
# TRADING_MAX_ETH_PER_TRADE=0.01
# TRADING_MIN_ETH_RESERVE=0.002
# TRADING_MAX_TRADES_PER_DAY=10
# TRADING_SLIPPAGE_BPS=100
# DRY_RUN=true

# X / Twitter — cross-post Moltbook posts & comments to @notbitcoinceo
# App keys (Consumer Key = API Key):
# X_API_KEY=
# X_API_SECRET=
# X_CONSUMER_KEY=
# X_BEARER_TOKEN=
# OAuth 2.0 (required for Connect X button):
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Optional OAuth 1.0a user tokens (alternative to Connect):
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Callback must match Developer Portal exactly:
# X_CALLBACK_URL=https://punaab.vercel.app/api/auth/x/callback
# X_CROSSPOST_ENABLED=true
# Reply to mentions/comments on your X posts (chill funny); default follows CROSSPOST
# X_ENGAGE_ENABLED=true
# X_REPLY_MAX_PER_TICK=1
# One original X post per day inspired by Moltbook (default on)
# X_DAILY_ORIGINAL=true

# OpenSolve — Proof of Meaning research network (https://open-solve.com/en/docs)
# Register → claim URL → set key. Cron: /api/cron/opensolve every 15m
# OPENSOLVE_ENABLED=true
# OPENSOLVE_AGENT_KEY=
# OPENSOLVE_AGENT_NAME=Punaab
# OPENSOLVE_ROLE=RESEARCHER
# OPENSOLVE_DAILY_TWEET=true
# Research-sourced X posts: hard max 1 per UTC day (never name OpenSolve)
# OPENSOLVE_MAX_TWEETS_PER_DAY=1
# OPENSOLVE_API_BASE=https://api.open-solve.com
# OPENSOLVE_SITE_BASE=https://open-solve.com

# Once-daily LDS scripture verse on X (standard works via Open Scripture API)
# X_DAILY_SCRIPTURE=true

# Limbothy lore tweets are permanently disabled.
# Traveling Bard story tweets → punaab.com + Pump $PUNAAB (max 4/day)
# PUNAAB_STORY_TWEETS_ENABLED=true
# PUNAAB_STORY_MAX_TWEETS_PER_DAY=4
# PUNAAB_PUMP_MINT=8xWMreut8z93Pg4Uh1HgY9eWNJJxUtyWnGPjjnuJpump

# Copy-trade Solana wallets from Axiom Vision (https://axiom.trade/vision)
# Paste high-winrate wallet addresses; first tick baselines, then mirrors buys/sells
# COPY_TRADE_ENABLED=true
# COPY_TRADE_DRY_RUN=true
# COPY_TRADE_WALLETS=Wallet1,Wallet2
# COPY_TRADE_MAX_SOL=0.05
# COPY_TRADE_MAX_PER_DAY=8

# Jupiter Prediction Markets — short-term Up/Down (YES/NO) on Solana
# Docs: https://dev.jup.ag/docs/prediction — Forecast (bisonfi 15m BTC) recommended
# Get key at https://portal.jup.ag — geo-restricted (US/KR blocked)
# JUPITER_API_KEY=
# Free portal tier ≈ 1 req/s org-wide — prediction trader paces calls (see rate limits).
# Upgrade at https://portal.jup.ag if you still hit 429s.
# PREDICTION_JUPITER_MIN_INTERVAL_MS=1100
# PREDICTION_JUPITER_MAX_RETRIES=4
# PREDICTION_MIN_BUY_PRICE=0.04
# PREDICTION_MAX_ADVERSE_SLIP=0.03
# PREDICTION_TRADING_ENABLED=true
# ~$230 Forecast bankroll caps (prod); keep DRY_RUN=false only on Vercel (not US IP)
# PREDICTION_MAX_USDC_PER_LEG=40
# PREDICTION_MAX_FORECAST_USDC=80
# PREDICTION_MAX_USDC_PER_MARKET=80
# PREDICTION_MAX_OPEN_MARKETS=4
# PREDICTION_MIN_COMBINED_EDGE_BPS=150
# PREDICTION_POLL_INTERVAL_MS=20000
# Also runs on Vercel cron every 2 minutes: GET /api/cron/prediction
# PREDICTION_ROTATION_ENABLED=true
# PREDICTION_INVENTORY_MM_ENABLED=false
# PREDICTION_RESOLUTION_SNIPE_ENABLED=false
# Directional scalp (Polymarket-style: buy 1–30¢ mispriced Up/Down, hold to $1)
# PREDICTION_SCALP_ENABLED=true
# PREDICTION_SCALP_MAX_ENTRY=0.45
# PREDICTION_SCALP_MIN_EDGE=0.06
# PREDICTION_SCALP_PCT_OF_WALLET=0.12
# PREDICTION_SCALP_USDC_RESERVE=25
# PREDICTION_SCALP_MAX_USDC=25
# Auto-swap SOL / other SPL → USDC before Forecast buys (default on)
# PREDICTION_AUTO_FUND_USDC=true
# PREDICTION_MIN_FUND_TOKEN_USD=1
# Jupiter Prediction blocks US + South Korea IPs on /orders.
# Vercel prediction cron uses preferredRegion=sin1; local trader needs non-US egress/VPN.
# PREDICTION_SCALP_ALLOW_POLYMARKET=false
# PREDICTION_SCALP_LONGSHOT=true
# PREDICTION_MAX_TRADES_PER_DAY=500
# PREDICTION_MAX_SIGNALS_PER_TICK=2
# Solana Forecast pipeline (VALIX-style on Jupiter BISON 15m)
# PREDICTION_FUSION_ENABLED=true
# PREDICTION_MIN_ML_EDGE=0.08
# PREDICTION_MIN_FUSION_CONF=0.25
# PREDICTION_KELLY_FRACTION=0.25
# PREDICTION_MIN_ENTRY_PRICE=0.05
# PREDICTION_MAX_ENTRY_PRICE=0.75
# PREDICTION_MAX_SPREAD_PCT=0.08
# PREDICTION_MAX_TRADES_PER_MARKET=1
# PREDICTION_LOCK_DIRECTION=true
# PREDICTION_MAX_CHASE_DELTA=0.12
# PREDICTION_LATE_ENTRY_CUTOFF_SEC=120
# PREDICTION_TAKE_PROFIT_PCT=0.40
# PREDICTION_SCALP_TAKE_PROFIT=true
# PREDICTION_MAX_DAILY_DEPLOY_USDC=200

# Telegram owner control bot (message @BotFather to create)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Optional: random secret for webhook hardening (openssl rand -hex 16)
# TELEGRAM_WEBHOOK_SECRET=
