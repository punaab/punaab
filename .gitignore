# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.tmp-plugin-pack/

# Supabase CLI local cache (never commit)
supabase/.temp/

# Local inspection / scratch outputs
scripts/*.png
scripts/*.bin
scripts/*-vert-indices.json

# Raw Meshy/export packs (often >100MB). Runtime uses the .glb files.
public/assets/models/*.zip

